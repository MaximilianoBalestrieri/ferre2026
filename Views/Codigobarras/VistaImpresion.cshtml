@model ImprimirCodigoBarrasViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Imprimir etiquetas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>

        body {
            margin: 0;
            padding: 10px;
            background: white;
            font-family: Arial, Helvetica, sans-serif;
        }

        .contenedor-etiquetas {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .etiqueta {

            width: 70mm;

            border: 1px dashed #ccc;

            padding: 8px;

            text-align: center;

            page-break-inside: avoid;

            background: white;
        }

        .nombre-producto {

            font-size: 13px;

            font-weight: bold;

            margin-bottom: 5px;

            overflow: hidden;
        }

        .codigo-texto {

            font-size: 11px;

            margin-top: 5px;

            letter-spacing: 1px;
        }

        .barcode-img {

            width: 100%;

            height: auto;
        }

        @@media print {

            body {
                margin: 0;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }

            .etiqueta {
                border: none;
            }

        }

    </style>

</head>

<body>

    <div class="no-print mb-3 text-center">

        <button class="btn btn-success"
                onclick="window.print()">

            <i class="bi bi-printer"></i>
            Imprimir

        </button>

        <a href="@Url.Action("Imprimir", "Codigobarras", new { id = Model.ProductoId })"
           class="btn btn-secondary">

            Volver

        </a>

    </div>

    <div class="contenedor-etiquetas">

        @for (int i = 0; i < Model.Cantidad; i++)
        {
            <div class="etiqueta">

                <div class="nombre-producto">
                    @Model.NombreProducto
                </div>

                <img src="@Url.Action("GenerarImagen", "Codigobarras", new { codigo = Model.Codigo })"
     class="barcode-img" />

                <div class="codigo-texto">
                    @Model.Codigo
                </div>

            </div>
        }

    </div>

    <script>

        window.onload = function () {

            setTimeout(() => {
                window.print();
            }, 500);

        };

    </script>

</body>

</html>