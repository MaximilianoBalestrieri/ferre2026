@using GestionVentas.Models
@model List<GestionVentas.Models.Usuario>

<h2>Gestión de Usuarios</h2>

<div class="mb-3">
    <input type="text" id="buscadorUsuarios" class="form-control shadow-sm" style="max-width:600px;"
           placeholder="🔍 Buscar por nombre y apellido..." autofocus />
</div>

<a href="@Url.Action("Create")" class="btn btn-success mt-2">Agregar Usuario</a>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre y Apellido</th>
            <th>Usuario</th>
            <th>Rol</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody id="tablaUsuarios">
        @foreach (var u in Model)
        {
            <tr>
                <td>
                    <img src="@(!string.IsNullOrEmpty(u.FotoPerfil) ? u.FotoPerfil : "/imagenes/usuarios/default.png")"
                         class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;" />
                </td>
                <td>@u.NombreyApellido</td>
                <td>@u.UsuarioNombre</td>
                <td>@u.Rol</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = u.IdUsuario })" class="btn btn-warning btn-sm">Editar</a>
                    <a href="@Url.Action("Delete", new { id = u.IdUsuario })" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    const inputBusqueda = document.getElementById("buscadorUsuarios");
    const tablaUsuarios = document.getElementById("tablaUsuarios");

    inputBusqueda.addEventListener("input", function () {
        const filtro = inputBusqueda.value;

        fetch(`/Usuarios/BuscarUsuarios?filtro=${encodeURIComponent(filtro)}`)
            .then(response => response.json())
            .then(data => {
                tablaUsuarios.innerHTML = "";

                if (data.length === 0) {
                    tablaUsuarios.innerHTML = `
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No se encontraron usuarios
                            </td>
                        </tr>`;
                    return;
                }

                data.forEach(u => {
                    const fila = `
                        <tr>
                            <td>
                                <img src="${u.fotoPerfil || '/imagenes/usuarios/default.png'}"
                                     class="rounded-circle"
                                     style="width: 60px; height: 60px; object-fit: cover;" />
                            </td>
                            <td>${u.nombreyApellido}</td>
                            <td>${u.usuarioNombre}</td>
                            <td>${u.rol}</td>
                            <td>
                                <a href="/Usuarios/Edit/${u.idUsuario}" class="btn btn-warning btn-sm">Editar</a>
                                <a href="/Usuarios/Delete/${u.idUsuario}" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    `;

                    tablaUsuarios.innerHTML += fila;
                });
            })
            .catch(error => console.error("Error al buscar usuarios:", error));
    });

    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("buscadorUsuarios");

        input.focus();

        if (input.value.length > 0) {
            input.select();
        }
    });


</script>